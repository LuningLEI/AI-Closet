APP_NAME=AI Closet API
APP_ENV=development
ALLOWED_ORIGINS=
OBSERVABILITY_TOKEN=replace-with-a-long-random-secret

DATA_DIR=./data
UPLOADS_DIR=./data/uploads
ITEMS_PATH=./data/items.json
RECOGNITION_RECORDS_PATH=./data/recognition_records.json
RECOGNITION_JOBS_PATH=./data/recognition_jobs.json
ITEM_EDIT_EVENTS_PATH=./data/item_edit_events.json
ITEM_FEATURE_SNAPSHOTS_PATH=./data/item_feature_snapshots.json
STORAGE_MODE=local

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=closet-images

OPENAI_API_KEY=your-openai-api-key
# Shadow-evaluation credentials only; neither key is used by production unless
# its provider is explicitly selected.
HF_TOKEN=your-hugging-face-token
NOVITA_API_KEY=your-novita-api-key
GEMINI_API_KEY=your-gemini-api-key
# The orchestration gateway supports OpenAI-compatible hosted or self-hosted APIs.
AI_PROVIDER=openai
AI_API_KEY=your-provider-api-key
# AI_BASE_URL=https://your-openai-compatible-host/v1
# Optional fail-closed comma-separated allowlist; include embedding models when enabled.
AI_ALLOWED_MODELS=
# For Chat Completions providers: json-schema, json-object, or none.
AI_CHAT_SCHEMA_MODE=json-schema
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_DETAIL=low
RECOGNITION_AI_PROVIDER=chat-completions
RECOGNITION_AI_BASE_URL=https://api.novita.ai/openai/v1
RECOGNITION_AI_SCHEMA_MODE=json-schema
RECOGNITION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
RECOGNITION_REPAIR_MODEL=qwen/qwen3.8-flash
RECOGNITION_REPAIR_ENABLED=true
RECOGNITION_IMAGE_MAX_DIMENSION=2048

# Outfit generation is metadata-only on HF; composite selection/review uses Novita.
OUTFIT_GENERATION_AI_PROVIDER=chat-completions
OUTFIT_GENERATION_AI_BASE_URL=https://api.novita.ai/openai/v1
OUTFIT_GENERATION_AI_SCHEMA_MODE=json-schema
OUTFIT_VISUAL_AI_PROVIDER=chat-completions
OUTFIT_VISUAL_AI_BASE_URL=https://api.novita.ai/openai/v1
OUTFIT_VISUAL_AI_SCHEMA_MODE=json-schema
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

RECOGNITION_WORKER_BATCH_SIZE=3
RECOGNITION_WORKER_POLL_SECONDS=2
RECOGNITION_WORKER_MAX_ATTEMPTS=4
RECOGNITION_WORKER_JOB_TIMEOUT_SECONDS=120
RECOGNITION_WORKER_RETRY_BASE_SECONDS=10
RECOGNITION_WORKER_RETRY_MAX_SECONDS=300

# Keep true for Supabase-backed iOS clients. Set false only for local JSON-file demos.
REQUIRE_AUTH_FOR_MUTATIONS=true

# Independent occasion suitability cutoff (inclusive, 0..1).
RECOGNITION_OCCASION_THRESHOLD=0.8

# Optional override; relative prompt paths resolve beside this JSON file.
# Default: backend/app/outfits/config.json
# OUTFIT_CONFIG_PATH=/absolute/path/to/outfit-config.json
